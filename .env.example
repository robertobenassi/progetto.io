# Database
DB_USER=progetto_user
DB_PASSWORD=cambia_questa_password
DB_NAME=progetto_db

# Chiave di firma dei token di accesso.
# Generarne una casuale:  openssl rand -hex 32
JWT_SECRET=cambia_questo_secret_con_una_stringa_casuale_lunga

# Ambiente
NODE_ENV=production

# Porta locale su cui risponde l'applicazione.
# Il reverse proxy (Caddy, nginx, Traefik) va puntato qui.
APP_PORT=8080

# Interfaccia di ascolto. Il valore predefinito 127.0.0.1 rende l'applicazione
# raggiungibile solo dal server stesso: e' quello corretto quando davanti c'e'
# un reverse proxy, perche' impedisce di scavalcarlo arrivando in HTTP.
# Usare 0.0.0.0 solo in rete locale fidata e senza proxy.
APP_BIND=127.0.0.1
