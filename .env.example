# Database
DB_USER=progetto_user
DB_PASSWORD=cambia_questa_password
DB_NAME=progetto_db

# Chiave di firma dei token di accesso.
# Generarne una casuale:  openssl rand -hex 32
JWT_SECRET=cambia_questo_secret_con_una_stringa_casuale_lunga

# ---------------------------------------------------------------------------
# Amministratore iniziale
# Obbligatorie al primo avvio: senza, il backend si ferma con un messaggio.
# Vengono usate una sola volta, alla creazione del primo amministratore;
# nei riavvii successivi sono ignorate e nulla viene sovrascritto.
# La password deve avere almeno 8 caratteri e va cambiata dopo il primo accesso.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=tuo.indirizzo@esempio.it
ADMIN_PASSWORD=scegli_una_password_lunga

# Numero di reverse proxy davanti all'applicazione. Serve a riconoscere
# l'indirizzo reale di chi si collega: da questo dipende il limite ai
# tentativi di accesso, che altrimenti bloccherebbe tutti insieme.
# Il valore 1 va bene nella maggior parte dei casi, incluso l'avvio autonomo.
# Verificabile da un amministratore aprendo /api/whoami: se l'indirizzo
# mostrato non e quello reale di chi si collega, il valore va corretto.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Installazione autonoma con HTTPS (facoltativa)
# Servono solo se si avvia con:  docker compose --profile standalone up -d
# In quel caso viene incluso un reverse proxy che ottiene e rinnova da se' il
# certificato. Chi ha gia' un proprio proxy puo' ignorare queste due righe.
# ---------------------------------------------------------------------------
DOMAIN=progetti.esempio.com
ACME_EMAIL=tuo.indirizzo@esempio.com

# Ambiente
NODE_ENV=production

# Porta locale su cui risponde l'applicazione.
# Il reverse proxy (Caddy, nginx, Traefik) va puntato qui.
APP_PORT=8080

# Interfaccia di ascolto. Il valore predefinito 127.0.0.1 rende l'applicazione
# raggiungibile solo dal server stesso: e' quello corretto quando davanti c'e'
# un reverse proxy, perche' impedisce di scavalcarlo arrivando in HTTP.
# Usare 0.0.0.0 solo in rete locale fidata e senza proxy.
APP_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Posta elettronica (facoltativa)
# Senza SMTP_HOST il recupero password non compare nell'interfaccia e l'invito
# ai tecnici si condivide solo copiando il link.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true solo con la porta 465
# SMTP_USER=noreply@tuodominio.it
# SMTP_PASS=password_della_casella
# SMTP_FROM=Progetto.io <noreply@tuodominio.it>

# Indirizzo pubblico dell'applicazione, usato nei link inviati per email
# APP_URL=https://progetti.tuodominio.it

# Origini ammesse per le chiamate dal browser, separate da virgola.
# Vuoto = solo lo stesso host (configurazione normale con reverse proxy).
# CORS_ORIGINS=https://progetti.tuodominio.it
